{
  "name": "irctc-cypress-automation",
  "version": "1.0.0",
  "description": "IRCTC Ticket Booking Automation — General, Tatkal, Premium Tatkal",
  "scripts": {
    "test": "cypress run --browser chrome --headed",
    "test:electron": "cypress run",
    "test:edge": "cypress run --browser edge --headed",
    "test:booking": "cypress run --browser chrome --headed --spec cypress/e2e/irctc.cy.js",
    "test:entry": "cypress run --browser edge --headed --spec cypress/e2e/irctc-entry.cy.js",
    "test:login": "cypress run --browser edge --headed --spec cypress/e2e/irctc-login.cy.js",
    "open": "cypress open",
    "validate": "node --check cypress.config.js"
  },
  "author": "Prince Shrivastava",
  "license": "ISC",
  "dependencies": {
    "cypress": "^13.17.0",
    "dayjs": "^1.11.13"
  },
  "devDependencies": {}
}
